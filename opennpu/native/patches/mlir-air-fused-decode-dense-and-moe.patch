+class LazyLayers:
+    """Per-layer weights dequantized on first access instead of all up front.
+
+    Holding all 36 dequantized bf16 layers on the host (~16 GB) next to their
+    resident BO copies (~16 GB) is what made the 8B prefill OOM. Once a layer's
+    weights are resident on the device, `release(k)` swaps them for zero-stride
+    placeholders of the same shape: the prefill only reads static inputs on the
+    first call per bo_key and needs nothing but their size afterwards.
+    """
+
+    def __init__(self, make, n):
+        self._make, self._n, self._cache = make, n, {}
+        self.stream = False  # release layer k-1 when layer k is first touched
+        self._released = set()
+
+    def __len__(self):
+        return self._n
+
+    def __iter__(self):
+        return (self[k] for k in range(self._n))
+
+    def __getitem__(self, k):
+        if k not in self._cache:
+            if self.stream and k > 0:
+                self.release(k - 1)
+            self._cache[k] = self._make(k)
+        return self._cache[k]
+
+    def release(self, k):
+        lw = self._cache.get(k)
+        if lw is None or k in self._released:
+            return
+        self._released.add(k)
+        for f in lw.__dataclass_fields__:
+            a = getattr(lw, f)
+            if isinstance(a, np.ndarray) and a.size > 4096:
+                setattr(lw, f, np.broadcast_to(np.zeros(1, a.dtype), a.shape))
+
