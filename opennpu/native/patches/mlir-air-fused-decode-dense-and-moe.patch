+  // bf16 rms = aie::sqrt(mean_square + epsilon);
+  // bf16 divrms = aie::div(1, (bf16)32);
+  // compute 1 / sqrt(sum + epsilon), use magic
+  sum = sum + epsilon;
+  float x2, divrms;
+  const float threehalfs = 1.5F;
+  uint32_t i_u32;
