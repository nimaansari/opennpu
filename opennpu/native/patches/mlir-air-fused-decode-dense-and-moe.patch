+
+// 2 kv heads per CU x 8 padded q heads (see attn_qk.cc). Every routine is the
+// 1x8x1 one applied per kv group g:
+//   S  [16 heads][16 keys]: group g's 8x16 slab at pS + g*128
+//   c/l indexed by padded head: group g at +g*8
+//   V  block [keyhalf][kv][DH/8][8 keys][8 dh]: kv g, chunk j at
+//      pV + (g*colQ + j)*64, key half 1 another 2*colQ*64 on
+//   y  [DH/8][16][8] (f32): group g's 8x8 tile of chunk j at pY + j*128 + g*64
+ATTN_HOT
+void calculate_l(bf16 *__restrict pS, float *__restrict c,
+                 float *__restrict l) {
+  aie_round_nearest_even();
+  using MMUL = aie::mmul<8, 8, 8, bf16, bf16, accfloat>;
+  AIE_LOOP_UNROLL_FULL
+  for (int g = 0; g < KV_HEADS_PER_CU; g++) {
+    bf16 *__restrict pS1 = pS + g * 128;
+    aie::vector<bf16, 64> S_up = aie::load_v<64>(pS1);
+    aie::vector<bf16, 64> S_down = aie::load_v<64>(pS1 + 64);
+    aie::vector<bf16, MMUL::size_A> S0 =
+        aie::concat(aie::filter_even(S_up, 8), aie::filter_even(S_down, 8));
+    aie::vector<bf16, MMUL::size_A> S1 =
+        aie::concat(aie::filter_odd(S_up, 8), aie::filter_odd(S_down, 8));
+    aie::vector<bf16, MMUL::size_B> ones =
+        aie::broadcast<bf16, MMUL::size_B>(1);
+    aie::vector<bf16, MMUL::size_C> acc_C00 = aie::zeros<bf16, MMUL::size_C>();
+    MMUL C00(acc_C00);
+    C00.mac(S0, ones);
+    C00.mac(S1, ones);
+    aie::vector<float, MMUL::size_C> sumf = C00.template to_vector<float>();
+    auto sum03 = aie::filter_even(sumf, 4);
+    auto sum02 = aie::filter_even(sum03, 2);
+    auto sum01 = aie::filter_even(sum02, 1); // 8 row sums
+    aie::accum<accfloat, 16> sum;
+    sum.from_vector(aie::concat(sum01, sum01));
+    aie::vector<float, 8> c8 = aie::load_v<8>(c + g * 8);
+    aie::vector<float, 8> l8 = aie::load_v<8>(l + g * 8);
+    aie::accum<accfloat, 16> l_out = mac_elem_16_accuracy_safe(
+        aie::concat(l8, l8), aie::concat(c8, c8), sum, 0, 0, 0);
+    // store only this group's 8 (the 16-wide result is two copies)
+    aie::store_v(l + g * 8,
+                 l_out.template to_vector<float>().template extract<8>(0));
+  }
+}
