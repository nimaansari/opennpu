+template <unsigned colQ, unsigned r, unsigned s, unsigned t>
+ATTN_HOT void attn_fv(bf16 *__restrict pS, bf16 *__restrict pV,
+                      y_acc_dtype *__restrict pY, float *__restrict c) {
+  using MMUL = aie::mmul<r, s, t, bf16, bf16, accfloat>;
+  constexpr unsigned YSTRIDE = KV_HEADS_PER_CU * MMUL::size_C; // 128
+  // Same peano-safe shape as 2x4x1: a pure-vector correction pass, then a mac
+  // pass from a ZERO-init accumulator with the carried y added as a vector
+  // (the load-initialised MMUL drops lane 0 under peano).
+  for (int g = 0; g < KV_HEADS_PER_CU; g++) {
+    aie::vector<bf16, 64> S_up = aie::load_v<64>(pS + g * 128);
+    aie::vector<bf16, 64> S_down = aie::load_v<64>(pS + g * 128 + 64);
+    aie::vector<bf16, MMUL::size_A> S0 =
+        aie::concat(aie::filter_even(S_up, 8), aie::filter_even(S_down, 8));
+    aie::vector<bf16, MMUL::size_A> S1 =
+        aie::concat(aie::filter_odd(S_up, 8), aie::filter_odd(S_down, 8));
+    const float *cg = c + g * 8;
+    {
+      aie::vector<y_acc_dtype, 64> CORRECT = aie::concat(
+          aie::broadcast<float, 8>(cg[0]), aie::broadcast<float, 8>(cg[1]),
+          aie::broadcast<float, 8>(cg[2]), aie::broadcast<float, 8>(cg[3]),
+          aie::broadcast<float, 8>(cg[4]), aie::broadcast<float, 8>(cg[5]),
+          aie::broadcast<float, 8>(cg[6]), aie::broadcast<float, 8>(cg[7]));
+      for (unsigned j = 0; j < colQ; j += 1) {
+        y_acc_dtype *__restrict pYc = pY + j * YSTRIDE + g * MMUL::size_C;
+        aie::store_v(pYc, aie::mul(CORRECT, aie::load_v<MMUL::size_C>(pYc))
+                              .template to_vector<y_acc_dtype>());
+      }
+    }
+    bf16 *__restrict pVg = pV + g * colQ * MMUL::size_B;
+    for (unsigned j = 0; j < colQ; j += 1) {
+      y_acc_dtype *__restrict pYc = pY + j * YSTRIDE + g * MMUL::size_C;
+      bf16 *__restrict pVa = pVg + j * MMUL::size_B;
+      aie::vector<y_acc_dtype, MMUL::size_C> yprev =
+          aie::load_v<MMUL::size_C>(pYc);
+      aie::vector<bf16, MMUL::size_C> zc = aie::zeros<bf16, MMUL::size_C>();
+      MMUL Y0(zc);
+      Y0.mac(S0, aie::load_v<MMUL::size_B>(pVa));
+      Y0.mac(S1, aie::load_v<MMUL::size_B>(pVa + MMUL::size_B * colQ * 2));
+      aie::store_v(pYc,
+                   aie::add(Y0.template to_vector<y_acc_dtype>(), yprev));
+    }
+  }
+}
