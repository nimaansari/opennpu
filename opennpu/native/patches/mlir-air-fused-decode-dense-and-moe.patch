+  aie::vector<float, vector_size> mx_vec;
+
+  const int F = MODEL_DIM / vector_size;
+  for (int i = 0; i < F; i++) {
+    auto x_vec = aie::load_v<vector_size>(it_x);
+    sum_squares = aie::mac_square(sum_squares, x_vec);
+    it_x += vector_size;
