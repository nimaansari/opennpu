+"""One-load benchmark: NPU prefill TTFT at several prompt lengths + fused decode tok/s."""
+import os, sys, time
+import numpy as np
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import qwen3_8b_q4nx_inference as inf
+
+model = os.environ["Q4NX_MODEL_SOURCE"]
+NTOK = int(os.environ.get("NTOK", "128"))
+LENS = [int(x) for x in os.environ.get("LENS", "17,512,1500").split(",")]
+
+t = time.perf_counter()
+pf = inf._build_prefiller(model)
+print(f"[bench] load {time.perf_counter()-t:.1f}s", flush=True)
+rng = np.random.default_rng(0)
+res = {}
+for L in LENS:
+    pf.clear_context()
+    ids = [int(x) for x in rng.integers(1000, 100000, L)]
+    Kc, Vc, first, ttft = inf._prefill_turn(pf, ids)
+    res[L] = ttft
+    print(f"[bench] prefill L={L}: {ttft:.2f}s  ({L/ttft:.0f} tok/s)", flush=True)
+
+dec = inf.FusedDecoder(model=model, max_L=2048)
+pf.clear_context()
+prompt = [int(x) for x in rng.integers(1000, 100000, 64)]
+Kc, Vc, first, _ = inf._prefill_turn(pf, prompt)
+gen, td = inf._decode_loop(dec, prompt, first, NTOK, Kc, Vc, stop_on_eos=False)
+n = len(gen) - 1
+print(f"[bench] decode {n} tok in {td:.2f}s = {n/td:.2f} tok/s ({td/n*1000:.1f} ms/tok)", flush=True)
