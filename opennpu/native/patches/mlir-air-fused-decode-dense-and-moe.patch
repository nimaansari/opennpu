+template <unsigned N>
+__attribute__((noinline)) void scale_div_aie(bf16 *a, bf16 *o, float *l) {
+  // Scalar, like the 2x4x1 path: y/a is PADDED ([DH/8][16][8]), o is PACKED
+  // ([DH/8][Q_HEADS_PER_CU][8]) to match the attnO gather.
+  constexpr int QHP = Q_HEADS_PADDED_PER_CU;
+  constexpr int o_tile = Q_HEADS_PER_CU * 8;
+  bf16 invl[QHP];
+  for (int h = 0; h < QHP; h++)
+    invl[h] = (bf16)getInvBf16(l[h]);
+  for (int d = 0; d < DH / 8; d++) {
+    bf16 *pa = a + d * QHP * 8;
+    bf16 *po = o + d * o_tile;
+    for (int g = 0; g < KV_HEADS_PER_CU; g++) {
+      for (int h = 0; h < Q_HEADS_PER_GROUP; h++) {
+        int grp = g * Q_HEADS_PER_GROUP_PADDED + h;
+        int op = g * Q_HEADS_PER_GROUP + h;
+        bf16 iv = invl[grp];
+        for (int k = 0; k < 8; k++)
+          po[op * 8 + k] = (bf16)((float)pa[grp * 8 + k] * (float)iv);
+      }
+    }
+  }
+}
