+  x2 = sum * 0.5F;
+  divrms = sum;
+  i_u32 = *(uint32_t *)&divrms;      // evil floating point bit level hacking
+  i_u32 = 0x5f3759df - (i_u32 >> 1); // what the fuck?
+  divrms = *(float *)&i_u32;
+  divrms = divrms * (threehalfs - (x2 * divrms * divrms)); // 1st iteration
+  divrms =
